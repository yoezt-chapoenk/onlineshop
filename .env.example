# Copy to .env.local for local development. Set the same variables in Vercel
# Project Settings → Environment Variables for the deployed site.
#
# When unset, the storefront falls back to the static seed in
# src/lib/products.ts so `npm run dev` keeps working without Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     # service role (server only)

# Admin dashboard (HTTP Basic Auth gate at /admin and /api/admin/*).
# If either is unset, /admin returns 503.
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me-in-vercel
